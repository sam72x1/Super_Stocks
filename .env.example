# 🔑 متغيّراتُ البيئة — **أسماءٌ بلا قيم** (خطة 022 · 2026-08-15)
#
# ⚠️ لا تضع قيمةً حقيقيةً في هذا الملفّ ولا في أيّ ملفٍّ مدفوع. الأسرارُ مكانها
# GitHub Secrets حصرًا (Settings → Secrets and variables → Actions)، والملفُّ هنا
# **جردٌ للتوثيق** يجيب: ما الذي يحتاجه كلُّ مسارٍ حيّ كي يعمل؟
#
# 🩺 والسببُ الذي وُلد له: السويّةُ (`python3 test_bot.py`) تعمل **بلا إنترنت
# بتصميمها** ⇒ خضرتُها لا تقول شيئًا عن كون المسار الحيّ موصولًا. فالجردُ أدناه
# هو الجواب المكتوب بدل استخراجه من الكود.

# ═══════════ أسرار (Secrets) — بلا قيمةٍ هنا أبدًا ═══════════
# 📨 قناةُ التسليم — يستهلكها **كلُّ** رنر يرسل للمالك (41 workflow)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # يقبل أكثر من رقمٍ بفاصلة

# 📈 بيانات لحظية/دقيقة — رادار الانطلاق · المراقب اللحظي · تدفّق الأوامر ·
#    قرينة الافتر في رادار الضغط (‏press_radar) · تجارب الصفقات
POLYGON_API_KEY=

# 📦 الملفّات المجمَّعة S3 (تجارب تاريخية فقط — `flatfiles_probe`/`ah_scan`)
POLYGON_S3_KEY=
POLYGON_S3_SECRET=

# 📅 أداةُ الأرباح ومصادرُ التقويم البديلة (اختيارية — الغيابُ يتدرّج للبديل)
ALPHAVANTAGE_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=

# 🏛️ ترويسةُ User-Agent لطلبات SEC (بريدٌ للتواصل — شرطُ SEC)
SEC_CONTACT=

# 🤖 مراجِعُ Cline الأسبوعي (اختياريّ — الوظيفةُ لا تعمل بدونه)
CLINE_API_KEY=

# ═══════════ أعلامُ تشغيل (Toggles) — لا أسرار ═══════════
# 🎛️ وضعُ التشغيل: (فارغ)=الفرز اليومي · BACKTEST · DIGEST (تحديث اليد المسائي)
SCREENER_MODE=
# 🥇 أرقامُ كاتالوج فيصل (الافتراضُ 1 في الإنتاج — 0 يرجع لبوّابات البوت)
FAISAL_ONLY=
# ♻️ إعادةُ بناء القائمة كاملةً مرّةً واحدة (يطلبه Claude عند تغيير جوهريّ)
FORCE_RENEW=
# 💰 حجمُ الحساب ونسبةُ المخاطرة لحساب حجم المركز (عرضٌ فقط)
ACCOUNT_SIZE=
RISK_PER_TRADE_PCT=

# 🔓 تخطّي بوّابة التوقيت والدِدوب في التشغيل اليدويّ (زرُّ المالك)
PRESS_RADAR_FORCE=
HUNTER_FORCE=
METHOD_FORCE=
ENVELOPE_FORCE=
SPLIT_FILTER_FORCE=

# 🔥 رادارُ الانطلاق (عاملُ الجلسة الحيّ)
IGNITION_INTERVAL=          # ثوانٍ بين اللفّات (افتراض 45)
IGNITION_SEGMENT=           # open | close | single
IGNITION_MAX_RUNTIME_MIN=
E2_MEASUREMENT=             # 1 = القياسُ الظلّي (مطفأ = سلوكُ الرادار حرفيًّا)

# 🕵️ أدواتٌ يدويّة (تُمرَّر عند التشغيل لا في البيئة الدائمة)
TICKER=                     # analyze_one.py / technical_report.py
HAND_CHECK=                 # hand_check.py — رمزُ فحص اليد
BACKTEST_YEAR=              # الباكتيست وأدواتُ التجارب
BT_FROZEN_PATH=             # لقطةُ PIT المجمَّدة

# 📌 وأعلامُ التجارب (‏BT_* · AH_* · CLIFF_* … ‏150 متغيّرًا) **ليست هنا عمدًا**:
#    كلُّ تجربةٍ توثّق أعلامَها في ملفّ تسجيلها المسبق (`*_prereg.md`) وفي
#    مدخلات الـworkflow الخاصّ بها — وجمعُها هنا يصنع جردًا يتعفّن.
